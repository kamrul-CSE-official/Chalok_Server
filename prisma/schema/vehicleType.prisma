enum VehicleStatus {
    RUNNING
    IDLE
    MAINTENANCE
    OUT_OF_SERVICE
}

model VehicleType {
    id        String        @id @default(uuid())
    nameBn    String        @db.VarChar(225)
    nameEn    String        @db.VarChar(225)
    image     String        @db.Text
    isActive  Boolean       @default(true)
    status    VehicleStatus @default(RUNNING)
    sortOrder Int           @default(0)

    enterById   String
    enterBy     User   @relation("VehicleTypeEnterBy", fields: [enterById], references: [id], onDelete: Restrict)
    updatedById String
    updatedBy   User   @relation("VehicleTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

    garageId   String
    garageInfo Garage @relation("VehicleGarage", fields: [garageId], references: [id], onDelete: Restrict)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    movements VehicleMovement[] @relation("VehicleMovements")

    @@index([enterById])
    @@index([updatedById])
    @@index([status])
    @@map("vehicle_types")
}
